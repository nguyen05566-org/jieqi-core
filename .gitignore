# Cookie files
# ck*.txt là nguồn cookie của bot và PHẢI được commit (repo private, không dùng
# secret). Trước đây ck2..ck11 bị ignore trong khi workflow vẫn dùng chúng →
# account mới rất dễ bị bỏ sót khỏi git. Không ignore ck*.txt nữa.
# (Cookie jar đầy đủ nằm trong state/cookies/ — đã ignore cùng state/.)
*.txt.bak
*.txt.old

# Local state / fingerprint dirs
# state/ được ignore NHƯNG state/tokens/ PHẢI được commit (token files cho ws_bot)
state/*
!state/tokens/
fingerprints/
transfer_dests.json

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Editor / OS
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# Logs / debug screenshots
*.log
debug_*.png
*.tmp

# Project-local scripts (not for sharing)
/tmp/
scripts/
